# ==========================================
# Shopora E-Commerce Production Environment
# ==========================================

# Security
# In production, generate a secure random 50+ character string
DJANGO_SECRET_KEY=replace-with-a-very-long-random-secret-key-at-least-50-chars

# Set to False in production
DJANGO_DEBUG=False

# Comma-separated list of allowed hostnames/domains
DJANGO_ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com,your-app.onrender.com,localhost,127.0.0.1

# Comma-separated list of trusted origins for CSRF POST requests (include https://)
DJANGO_CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com,https://your-app.onrender.com

# Database URL
# For SQLite (default development):
# DATABASE_URL=sqlite:///db.sqlite3
# For PostgreSQL (recommended production):
# DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/DB_NAME
DATABASE_URL=sqlite:///db.sqlite3

# SSL & Security Settings
# Set to True when your domain has an active SSL certificate
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000

# Media & Storage Strategy
# For local persistent volume:
MEDIA_STORAGE_BACKEND=local
# For AWS S3 / Cloudflare R2 / DigitalOcean Spaces (optional):
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_REGION_NAME=
